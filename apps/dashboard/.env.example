# ============================================================
# UniServe :: dashboard :: environment (Phase 1)
# Copy to .env.local for local dev. NEVER commit real secrets.
# ============================================================

# App
APP_ENV=development
NEXT_PUBLIC_TENANT_ID=t1

# api-gateway base URL (the dashboard calls the gateway REST API)
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080

# Administration -> System's service-health probe (server-side only) checks
# these directly, bypassing the gateway proxy — set to db-writer's (Railway)
# and ai-core's (Render) real URLs in production, or every service shows
# "Unreachable" (there's no localhost to reach from Vercel).
DB_WRITER_URL=http://localhost:8090
AI_CORE_URL=http://localhost:8001
