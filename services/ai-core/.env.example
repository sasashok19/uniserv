# ============================================================
# UniServe :: ai-core :: environment (Phase 1)
# Copy to .env for local dev. NEVER commit .env.
# Prefix: AI_CORE_*
# ============================================================

# App
APP_ENV=development
TENANT_ID=t1
# DEBUG|INFO|WARNING|ERROR|CRITICAL — INFO (default) logs everything; set
# ERROR in prod.
LOG_LEVEL=INFO

# HTTP
AI_CORE_PORT=8001

# Event bus (Valkey, Redis-compatible) — Feature 01
VALKEY_URL=redis://localhost:6379
EVENT_BUS_MAX_RETRIES=3
EVENT_BUS_RETRY_DELAY_MS=1000
EVENT_BUS_CONSUMER_GROUP=uniserve

# Downstream
DB_WRITER_URL=http://localhost:8090
DB_WRITER_INTERNAL_API_KEY=
# Delivers ai.reply.send (identity requests, follow-ups) via api-gateway's
# email test-send endpoint.
API_GATEWAY_URL=http://localhost:8080
# api-gateway's /test-send can do a real synchronous SMTP/API send, which is
# slower than the old mock path — bump this if you see httpx timeouts there.
EMAIL_SEND_TIMEOUT_SECONDS=30
# WhatsApp's Graph API call has no SMTP-style handshake, so this can be shorter.
WHATSAPP_SEND_TIMEOUT_SECONDS=15

# Identity resolver (Feature 03)
IDENTITY_MERGE_CONFIDENCE_THRESHOLD=0.85
IDENTITY_PENDING_TIMEOUT_HOURS=48
IDENTITY_ANON_REF_PREFIX=ANON
DEFAULT_REGION=IN

# Conversation / LLM (Feature 06 — OpenAI Responses API)
CONVERSATION_STATE_TTL_HOURS=2
AI_MAX_FOLLOWUP_QUESTIONS=2
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# DEPRECATED (Feature 27): unused. The conversation runs on the OpenAI
# Responses API and its instructions/tools are sent with every request from
# services/ai-core/app/conversation/tools.py. Kept only so an existing .env
# carrying this variable still loads. Safe to delete.
OPENAI_ASSISTANT_ID=
OPENAI_MODEL=gpt-4o-mini
